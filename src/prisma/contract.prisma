// use prisma-8

enum UserRole {
  CUSTOMER
  FARMER
  ADMIN
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  name      String?
  passwordHash String
  role      UserRole @default(CUSTOMER)
  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()
}
